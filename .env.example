# ===== 前端（Vite 构建时注入 import.meta.env）=====
VITE_SUPABASE_URL=<your-api-url>
VITE_SUPABASE_ANON_KEY=<public-anon-key>
VITE_APP_URL=<your-app-domain>
VITE_OCR_LIMIT=20
# 人机验证 Site Key（平台控制台创建；留空 = 降级为未启用）
VITE_TURNSTILE_SITE_KEY=

# ===== 云函数运行时（部署平台 secrets 配置，勿提交真实值）=====
SUPABASE_URL=<your-api-url>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
OCR_API_KEY=<可选，OCR 服务密钥>
APP_URL=<your-app-domain>
# 人机验证 Secret Key（服务端校验用）
TURNSTILE_SECRET_KEY=
# 可选：hostname 白名单（逗号分隔），只放行这些域名下签发的 token
TURNSTILE_ALLOWED_HOSTNAMES=<your-domain>,localhost
