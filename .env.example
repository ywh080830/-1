# ===== 前端（Vite 构建时注入 import.meta.env）=====
VITE_SUPABASE_URL=https://sticrfirfyegdbssdaqm.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>
VITE_APP_URL=https://yimei.cc.cd
VITE_OCR_LIMIT=20
# Cloudflare Turnstile Site Key（https://dash.cloudflare.com → Turnstile 创建）
# 留空 = 降级为「未启用人机验证」，生产环境必须填写
VITE_TURNSTILE_SITE_KEY=

# ===== Edge Functions 运行时（supabase secrets set 配置，勿提交真实值）=====
SUPABASE_URL=https://sticrfirfyegdbssdaqm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
OCR_API_KEY=<可选，真实 OCR API 密钥>
APP_URL=https://yimei.cc.cd
# Cloudflare Turnstile Secret Key（服务端校验用，supabase secrets set TURNSTILE_SECRET_KEY=xxx）
TURNSTILE_SECRET_KEY=
# 可选：hostname 白名单（逗号分隔），只放行这些域名下签发的 token
TURNSTILE_ALLOWED_HOSTNAMES=yimei.cc.cd,localhost
